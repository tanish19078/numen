# Google Gemini Enterprise / Gemini API Configuration
# Leave GEMINI_API_KEY blank for 100% deterministic offline demo & test mode.
# When set, Numen uses google-genai Smart Routing across Gemini 2.5 Flash & Pro.
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Numen Core Treasury & Sandbox Settings
NUMEN_DB_PATH=numen.db
NUMEN_CARD_TTL_SECONDS=60
NUMEN_ATTRIGUARD_DRIFT_THRESHOLD=0.25
NUMEN_HMAC_SECRET=numen-dev-sandbox-secret-change-in-prod
